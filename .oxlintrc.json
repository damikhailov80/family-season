{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // Файлы маршрутов Next обязаны экспортировать рядом с компонентом metadata и подобное.
      "files": ["src/app/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      /*
       * У фикстур Playwright второй аргумент зовётся `use` — это его имя в API,
       * и по нему тесты узнают фикстуру с первого взгляда. Линтер же видит
       * `use(...)` и принимает его за одноимённый хук React 19. Переименовать
       * дешевле, но тогда ловушка ждала бы каждую следующую фикстуру.
       */
      "files": ["e2e/**"],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    }
  ]
}
