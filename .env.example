# Вход через Google. Значения — в .env.local (он в .gitignore), а на Vercel
# те же три переменные заводятся в настройках проекта.

# Ключ, которым Auth.js шифрует куку сессии. Генерируется командой `npx auth secret`.
AUTH_SECRET=

# OAuth-клиент из Google Cloud Console (тип Web application). Разрешённые
# redirect URI: http://localhost:3000/api/auth/callback/google
# и https://<домен>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Хранилище настроек (PostgreSQL). Сайт работает и без него: без базы
# пропадают только настройки кабинета, постеры и печать не зависят от неё.
# Схема накатывается командой `npm run db:migrate` (на прод — руками, см. README).
# У облачной базы в строке обязан быть `?sslmode=require`: TLS в коде нигде не
# настраивается, и без пометки соединение пойдёт открытым текстом молча.
DATABASE_URL=

# Тестовая база для e2e (`npm run e2e:db`). Обязана быть отдельной от DATABASE_URL:
# перед каждым прогоном её схема сносится целиком и собирается заново из миграций
# и посева примеров. Скрипт откажется работать, если строка совпадёт с рабочей.
E2E_DATABASE_URL=

# Google Analytics: идентификатор потока вида G-XXXXXXXXXX. Пустое значение
# выключает не только счётчик, но и весь разговор о согласии — без него не
# рисуется ни баннер, ни ссылка «Куки» в подвале, ни раздел в кабинете, и на
# страницу не попадает ни байта Google. Спрашивать согласие на то, чего не
# происходит, нельзя.
#
# Переменная серверная намеренно (не `NEXT_PUBLIC_`): та подставляется сборкой,
# и выключить счётчик на Vercel без пересборки стало бы нельзя.
GA_ID=
