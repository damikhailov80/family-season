{
  "name": "family-season",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "palettes": "node tools/palettes/build.mjs",
    "icons": "node tools/icons/build.mjs",
    "qr": "node --import tsx tools/qr/build.ts",
    "db:migrate": "node --env-file-if-exists=.env.local tools/db/migrate.mjs",
    "logo": "node tools/logo/build.mjs",
    "typecheck": "tsc --noEmit",
    "db:status": "node --env-file-if-exists=.env.local tools/db/migrate.mjs --status",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx tools/db/seed-examples.ts",
    "db:reports": "node --env-file-if-exists=.env.local --import tsx tools/db/reports.ts",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "npm run e2e:db && npm run build && playwright test",
    "e2e:only": "playwright test",
    "e2e:db": "node --env-file-if-exists=.env.local tools/db/reset-e2e.mjs"
  },
  "dependencies": {
    "next": "^16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,css,json}": "prettier --write",
    "*.{ts,tsx}": "oxlint"
  }
}
